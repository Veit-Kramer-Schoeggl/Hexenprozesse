    "gutenhag-1661": {
      "titel": "Gutenhag (Hrastovec) 1661–1673",
      "beschreibung": "Eine Reihe von Verfahren der Herrschaft Gutenhag. Die Rollen wechseln: bei Schauberg und Wukinetz fuehrt Wolf Lorenz Laempertitsch als Bannrichter, bei Keyditsch und Apollonia zeichnet Johann Andre Barth als Bannrichter und Laempertitsch sitzt unter den Beisitzern, bei Kollar und Kopschitsch ist er Urteilssprecher. Die Gestaendnisse nennen uebereinstimmend das Gradisch-Kreuz und den Rohitschberg als Versammlungsorte.",
      "seiten": [
        "keyditsch.html",
        "schauberg.html",
        "kollar.html",
        "kopschitsch.html",
        "wukinetz.html"
      ]
    },
    "st-lambrecht-landgericht": {
      "titel": "Landgericht St. Lambrecht 1602–1614",
      "beschreibung": "Verfahren des Stiftsgerichts unter Bannrichter Georg Schaller. Hofrichter Ludwig Wurm und mehrere Beisitzer, darunter Caspar Offner, wirken über Jahre hinweg in denselben Rollen mit.",
      "seiten": [
        "dionys.html",
        "metnitz.html",
        "mschoepfer.html"
      ]
    },
    "luttenberg-1672": {
      "titel": "Luttenberg (Ljutomer) 1672",
      "beschreibung": "Eine zusammenhängende Verfolgungswelle des Landgerichts Luttenberg. Die Prozesse gegen Gera Scherb, ihre Schwester Marina Hörk und die elf im April inhaftierten Frauen sind im selben Aktenbestand COP 1672-IV-59 überliefert. Die Belastungen stützen sich durchweg auf Aussagen bereits Hingerichteter, die zum Zeitpunkt der Verhöre nicht mehr befragt werden konnten.",
      "archivsignatur": "COP 1672-IV-59",
      "seiten": [
        "scherb.html",
        "hoerk.html",
        "tuerk.html"
      ]
    },
    "lichtenegg": {
      "titel": "Hl. Dreifaltigkeit unter Lichtenegg 1695–1701",
      "beschreibung": "Zwei Verfahren am Landgericht der Dominikaner-Patres von Pettau bei der Hl. Dreifaltigkeit (Gorca bei Podlehnik), beide unter Bannrichter Dr. Peter Lucrety von Apostelen. Von beiden ist die Kostenaufstellung des Bannrichters erhalten.",
      "seiten": [
        "schepp.html",
        "glanitschnigg.html"
      ]
    }
  },
